{
  "name": "@ns-private/pyroscope",
  "version": "3.0.4",
  "description": "Embeddable Pyroscope profile visualization for N|Solid Console",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": "git@github.com:nodesource/pyroscope.git",
  "author": "NodeSource",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "http://packages-internal.nodesource.io"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "scripts": {
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "pack:local": "yarn pack"
  }
}
